@page "/configuracion"
@using DjTracksSessions.Web.Services

<section class="configuration-page" aria-labelledby="configuration-title">
    <header class="configuration-header">
        <p class="eyebrow">Configuración</p>
        <h2 id="configuration-title">Conexión de base de datos</h2>
        <p>Comprueba si la aplicación puede conectarse a la base de datos configurada. No se muestran datos de conexión.</p>
    </header>

    <article class="connection-card">
        <div class="connection-card-heading">
            <div>
                <p class="card-kicker">Diagnóstico seguro</p>
                <h3>Estado de conexión</h3>
            </div>
            <span class="connection-status @StatusClass" role="status">@StatusLabel</span>
        </div>

        <p class="connection-description">@StatusDescription</p>

        <button class="connection-check-button" type="button" @onclick="CheckConnectionAsync" disabled="@(_state == DatabaseConnectionState.Checking)">
            @(_state == DatabaseConnectionState.Checking ? "Comprobando conexión..." : "Comprobar conexión")
        </button>
    </article>
</section>
