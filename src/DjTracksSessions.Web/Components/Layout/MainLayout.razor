@inherits LayoutComponentBase

<div class="app-shell">
    <header class="shell-header">
        <NavLink class="shell-brand" href="/" Match="NavLinkMatch.All" aria-label="DJ Tracks y Sessions, inicio">
            <span class="shell-brand-mark" aria-hidden="true"><LucideIcon Name="disc-3" Size="18" /></span>
            <span>DJ Tracks <b>&amp; Sessions</b></span>
        </NavLink>

        <nav class="shell-nav" aria-label="Navegación principal">
            <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">Inicio</NavLink>
            <NavLink class="nav-link" href="/catalogo">Biblioteca</NavLink>
            <NavLink class="nav-link nav-link-settings" href="/configuracion">Configuración</NavLink>
        </nav>

        <div class="shell-header-actions">
            <ThemeToggle />
        </div>
    </header>

    <main class="shell-main">
        @Body
    </main>
</div>
