@inherits LayoutComponentBase

<div class="app-shell">
    <header class="shell-header">
        <NavLink class="shell-brand" href="/" Match="NavLinkMatch.All" aria-label="DJ Tracks y Sessions, inicio">
            <span class="shell-brand-mark" aria-hidden="true"><LucideIcon Name="disc-3" Size="18" /></span>
            <span>DJ Tracks <b>&amp; Sessions</b></span>
        </NavLink>

        <nav class="shell-nav" aria-label="Navegación principal">
            <BbNavigationMenu EnableKeyboardNavigation="true" Class="shell-nav-menu">
                <BbNavigationMenuList Class="shell-nav-list">
                    <BbNavigationMenuItem>
                        <BbNavigationMenuLink Href="/" Match="NavLinkMatch.All" Class="nav-link" ActiveCssClass="active">Inicio</BbNavigationMenuLink>
                    </BbNavigationMenuItem>
                    <BbNavigationMenuItem>
                        <BbNavigationMenuLink Href="/catalogo" Class="nav-link" ActiveCssClass="active">Biblioteca</BbNavigationMenuLink>
                    </BbNavigationMenuItem>
                    <BbNavigationMenuItem>
                        <BbNavigationMenuLink Href="/sesiones" Class="nav-link" ActiveCssClass="active">Sesiones</BbNavigationMenuLink>
                    </BbNavigationMenuItem>
                    <BbNavigationMenuItem>
                        <BbNavigationMenuLink Href="/configuracion" Class="nav-link" ActiveCssClass="active">Configuración</BbNavigationMenuLink>
                    </BbNavigationMenuItem>
                </BbNavigationMenuList>
            </BbNavigationMenu>
        </nav>

        <div class="shell-header-actions">
            <ThemeToggle />
        </div>
    </header>

    <main class="shell-main">
        @Body
    </main>
    <div class="persistent-player" aria-label="Reproductor persistente">
        <PlayerSurface />
    </div>
    <audio @ref="audio" preload="metadata" aria-label="Audio del reproductor global"></audio>
</div>
