@using DjTracksSessions.Web.Services
<section id="reproductor" class="player-surface" aria-labelledby="player-title">
    <div class="player-heading"><p class="eyebrow">Explorer / Player</p><h2 id="player-title">Reproductor</h2><span class="player-status" role="status">@StatusLabel</span></div>
    @if (Service.Queue.Current is null) { <div class="player-empty">La cola está vacía. Agregá pistas desde Gestión de pistas.</div> }
    else { <div class="player-track"><strong>@Service.Queue.Current.Title</strong><span>@Service.Queue.Current.Artist · @Service.Queue.Current.FileName</span></div><div class="player-controls"><button type="button" @onclick="Previous" disabled="@(!CanPrevious)">Anterior</button><button class="player-primary" type="button" @onclick="Toggle">@(Service.IsPlaying ? "Pausa" : "Reproducir")</button><button type="button" @onclick="Next">Siguiente</button><label>Volumen <input type="range" min="0" max="1" step="0.01" value="@Service.Volume" @oninput="VolumeChanged" /></label><label class="seek-control"><span class="sr-only">Posición</span><input type="range" min="0" max="@Service.Duration" step="0.1" value="@Service.Position" @oninput="SeekChanged" /></label></div>@if (Service.Status is PlaybackStatus.Loading) { <p class="player-state">Cargando audio...</p> } @if (Service.Status is PlaybackStatus.Unavailable or PlaybackStatus.Error) { <p class="player-state player-state-error" role="alert">@(Service.ErrorMessage ?? "El audio no está disponible.")</p> } @if (Service.Status is PlaybackStatus.Ended) { <p class="player-state">Pista finalizada. Usá Siguiente para continuar.</p> } }
    <div class="queue-panel"><div class="queue-header"><strong>Cola actual</strong><button type="button" @onclick="Clear" disabled="@(Service.Queue.Current is null)">Vaciar cola</button></div>@if (Service.Queue.Tracks.Count == 0) { <span class="queue-empty">Sin pistas en cola.</span> } else { <ol>@foreach (var track in Service.Queue.Tracks) { <li class="@(track == Service.Queue.Current ? "queue-current" : "")"><span>@track.Title</span><button type="button" aria-label="Quitar @track.Title" @onclick="() => Remove(track.Identity)">Quitar</button></li>}</ol> }</div>
</section>
