<Router AppAssembly="@typeof(Program).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(DjTracksSessions.Web.Components.Layout.MainLayout)" />
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(DjTracksSessions.Web.Components.Layout.MainLayout)">
            <section class="not-found-page">
                <h1>Página no encontrada</h1>
                <p>La ruta solicitada no existe dentro de la interfaz.</p>
            </section>
        </LayoutView>
    </NotFound>
</Router>
