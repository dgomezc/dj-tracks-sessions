{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/DjTracksSessions.Api/bin/Debug/net10.0/DjTracksSessions.Api.dll",
      "cwd": "${workspaceFolder}/src/DjTracksSessions.Api",
      "stopAtEntry": false,
      "console": "internalConsole",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5000",
        "MAIN_LIBRARY_PATH": "/home/david/repos/dj-tracks-fixtures/main",
        "PENDING_LIBRARY_PATH": "/home/david/repos/dj-tracks-fixtures/pending",
        "REMEMBER_LIBRARY_PATH": "/home/david/repos/dj-tracks-fixtures/remember",
        "SESSIONS_LIBRARY_PATH": "/home/david/repos/dj-tracks-fixtures/sessions"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    },
    {
      "name": "Debug Web",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/DjTracksSessions.Web/bin/Debug/net10.0/DjTracksSessions.Web.dll",
      "cwd": "${workspaceFolder}/src/DjTracksSessions.Web",
      "stopAtEntry": false,
      "console": "internalConsole",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5001"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    }
  ],
  "compounds": [
    {
      "name": "Debug API + Web",
      "configurations": ["Debug API", "Debug Web"]
    }
  ]
}
